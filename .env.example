# Public site URL (Origin / CSRF checks)
APP_URL=http://127.0.0.1:43123

# Long random secret used to sign session cookies (required in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true behind HTTPS in production
COOKIE_SECURE=false

# Stateless admin auth (no database)
ADMIN_EMAIL=admin@example.com
# Generate with: npm run admin:hash-password
# Escape $ as \$ in .env files (dotenv expands $vars), e.g. \$2b\$12\$...
ADMIN_PASSWORD_HASH=

# GitHub CMS (Contents read/write fine-grained PAT) — this repo only
GITHUB_OWNER=inoveronai-dev
GITHUB_REPO=profidepo_web
GITHUB_BRANCH=main
GITHUB_CONTENT_TOKEN=
